{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huttese",
  "compatibility_date": "2026-10-01",
  // Static assets only – no Worker script, no backend. Progress lives in the browser's localStorage.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
