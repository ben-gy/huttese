{
  "name": "huttese",
  "version": "1.0.0",
  "private": true,
  "description": "Learn Huttese – a Duolingo-style course for the language of Jabba the Hutt. Static Astro site on Cloudflare.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "test": "esbuild scripts/check-course.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-course.mjs --log-level=warning && node node_modules/.cache/check-course.mjs"
  },
  "dependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
