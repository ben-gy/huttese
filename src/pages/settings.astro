---
import Base from '../layouts/Base.astro';
---

<Base title="Settings">
  <header class="page-head">
    <h1>Settings</h1>
    <p>No account, no server: everything is saved in this browser’s local storage. Export a backup to move your progress to another device.</p>
  </header>

  <section class="section">
    <div class="settings-row">
      <div><b>Sound effects</b><p>Chimes for right and wrong answers.</p></div>
      <input type="checkbox" class="switch" data-setting="sound" aria-label="Sound effects" />
    </div>
    <div class="settings-row">
      <div><b>Pronunciation audio</b><p>Read words aloud using your device’s speech voice, pitched down Hutt-style.</p></div>
      <input type="checkbox" class="switch" data-setting="speech" aria-label="Pronunciation audio" />
    </div>
    <div class="settings-row">
      <div><b>Show latin letters under Hutt script</b><p>Turn off to force yourself to read the glyphs.</p></div>
      <input type="checkbox" class="switch" data-setting="latin" aria-label="Show latin letters" />
    </div>
    <div class="settings-row">
      <div><b>Theme</b></div>
      <div class="goal-options" data-theme-opts>
        <button type="button" data-v="">Auto</button>
        <button type="button" data-v="light">Light</button>
        <button type="button" data-v="dark">Dark</button>
      </div>
    </div>
    <div class="settings-row">
      <div><b>Daily goal</b><p>XP to earn each day to keep your streak meaningful.</p></div>
      <div class="goal-options" data-goals>
        <button type="button" data-v="10">Casual 10</button>
        <button type="button" data-v="30">Regular 30</button>
        <button type="button" data-v="50">Serious 50</button>
        <button type="button" data-v="100">Hutt 100</button>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Your progress</h2>
    <p class="hint" data-summary></p>
    <div class="btn-row">
      <button type="button" class="btn blue" data-export>Export backup</button>
      <label class="btn ghost">Import backup<input type="file" accept="application/json" data-import hidden /></label>
      <button type="button" class="btn danger" data-reset>Reset progress</button>
    </div>
    <p class="hint" data-msg role="status"></p>
  </section>

  <section class="section prose">
    <h2>About</h2>
    <p>
      An unofficial fan project – Star Wars, Jabba the Hutt and Huttese are trademarks of Lucasfilm Ltd. Your progress never leaves this browser; page
      visits are counted with cookie-less Cloudflare Web Analytics.
    </p>
    <p>Built by <a href="https://benrichardson.dev/">benrichardson.dev</a> · more in the <a href="https://lab.benrichardson.dev/">lab</a></p>
  </section>
</Base>

<script>
  import { load, update, reset, exportJSON, importJSON, streak } from '../lib/progress';
  import { ALL_LESSONS } from '../data/course';

  const render = () => {
    const p = load();
    document.querySelectorAll<HTMLInputElement>('[data-setting]').forEach((i) => {
      i.checked = !!p.settings[i.dataset.setting as 'sound' | 'speech' | 'latin'];
    });
    document.querySelectorAll('[data-goals] button').forEach((b) => b.setAttribute('aria-pressed', String(Number((b as HTMLElement).dataset.v) === p.dailyGoal)));
    document
      .querySelectorAll('[data-theme-opts] button')
      .forEach((b) => b.setAttribute('aria-pressed', String(((b as HTMLElement).dataset.v ?? '') === (p.settings.theme ?? ''))));
    const done = ALL_LESSONS.filter((l) => p.lessons[l.id]).length;
    document.querySelector('[data-summary]')!.textContent =
      `${p.xp} XP · ${streak(p)} day streak · ${done} of ${ALL_LESSONS.length} lessons complete · ${Object.keys(p.words).length} words practised`;
  };

  document.querySelectorAll<HTMLInputElement>('[data-setting]').forEach((i) =>
    i.addEventListener('change', () => update((p) => (p.settings[i.dataset.setting as 'sound' | 'speech' | 'latin'] = i.checked))),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-goals] button').forEach((b) =>
    b.addEventListener('click', () => {
      update((p) => (p.dailyGoal = Number(b.dataset.v)));
      render();
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-theme-opts] button').forEach((b) =>
    b.addEventListener('click', () => {
      const v = (b.dataset.v || '') as '' | 'light' | 'dark';
      update((p) => (p.settings.theme = v));
      if (v) document.documentElement.dataset.theme = v;
      else delete document.documentElement.dataset.theme;
      render();
    }),
  );

  const msg = document.querySelector<HTMLElement>('[data-msg]')!;
  document.querySelector('[data-export]')!.addEventListener('click', () => {
    const blob = new Blob([exportJSON()], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `huttese-progress-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(a.href);
  });
  document.querySelector<HTMLInputElement>('[data-import]')!.addEventListener('change', async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (!f) return;
    msg.textContent = importJSON(await f.text()) ? 'Backup restored.' : 'That file isn’t a Huttese backup.';
    render();
  });
  document.querySelector('[data-reset]')!.addEventListener('click', () => {
    if (!confirm('Erase all progress in this browser? This can’t be undone.')) return;
    reset();
    msg.textContent = 'Progress reset. Bo shuda, new ootmian.';
    render();
  });

  render();
</script>
